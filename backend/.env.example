# ==============================================================================
# AgriSphere AI Backend Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your local or production values.
# ==============================================================================

# --- Application Environment ---
ENV=development
LOG_LEVEL=INFO

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# --- Database Configuration ---
DATABASE_URL=sqlite:///agrisphere.db

# --- Authentication & Security ---
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRY_DAYS=7

# --- AI & Audio Integrations ---
# Google Gemini API key for AI advisory synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# AssemblyAI API key for speech recognition and transcription
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Murf AI API key for voice advisory text-to-speech audio synthesis
MURF_API_KEY=your_murf_api_key_here
