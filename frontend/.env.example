# ==============================================================================
# AgriSphere AI Frontend Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your local or production values.
# ==============================================================================

# Backend API Base URL (e.g. http://localhost:8000 for local dev or https://your-backend.onrender.com)
VITE_API_BASE=http://localhost:8000

# Application Name
VITE_APP_NAME=AgriSphere AI

# Environment Mode (development / production)
VITE_ENV=development

# Supabase Configuration (Optional for production deployment)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
